{
  "name": "tourism-booking-api",
  "version": "0.1.0",
  "description": "Tourism Booking Platform - REST API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test --experimental-test-coverage dist/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/init.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate --name"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@types/multer": "^2.1.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^3.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "prom-client": "^15.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bcrypt": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "*",
    "@types/jsonwebtoken": "*",
    "@types/node": "*",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
