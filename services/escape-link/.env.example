# Twilio credentials (ESC-782 / ESC-781)
# Provision via Twilio console: https://console.twilio.com
# Store secrets in 1Password or vault; never commit .env
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio phone number assigned to this account (E.164 format)
# Example: +815011234567
TWILIO_FROM_NUMBER=+81XXXXXXXXXX

# Target numbers for Nitto Suisan fallback (ESC-751)
NITTO_PRIMARY_NUMBER=+81162233460
NITTO_FALLBACK_NUMBER=+81162233140

# Optional: Twilio TwiML URL for call instruction delivery
# Leave blank to use default "say" verb
TWIML_URL=

# Optional: status callback URL for call completion webhooks
STATUS_CALLBACK_URL=
